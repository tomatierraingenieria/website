---
// Fuentes self-hosted (@fontsource) antes que el CSS global, que las usa en @theme.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';

interface Props {
  title?: string;
  description?: string;
  /** og:title y twitter:title; por defecto, `title`. */
  ogTitle?: string;
  /** og:description y twitter:description; por defecto, `description`. */
  ogDescription?: string;
  /** PNG de 1200×630 en public/. */
  image?: string;
  imageAlt?: string;
}

const {
  title = 'Certificados Energéticos y CAE en Galicia | Tomatierra Ingeniería',
  description = 'Tomatierra Ingeniería: certificados energéticos, auditorías y CAE en Galicia, y proyectos de recarga de vehículo eléctrico. Pide presupuesto sin compromiso.',
  ogTitle = title,
  ogDescription = description,
  image = '/og-image.png',
  imageAlt = 'Tomatierra Ingeniería: certificación energética en Galicia',
} = Astro.props;

const siteBase = Astro.site ?? 'https://tomatierraingenieria.com';
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const ogImageURL = new URL(image, siteBase);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://tomatierraingenieria.com/#website',
      url: 'https://tomatierraingenieria.com',
      name: 'Tomatierra Ingeniería',
      description: 'Certificados energéticos y CAE en Galicia',
      inLanguage: 'es-ES',
    },
    {
      '@type': 'Organization',
      '@id': 'https://tomatierraingenieria.com/#organization',
      name: 'Tomatierra Ingeniería',
      url: 'https://tomatierraingenieria.com',
      email: 'hola@tomatierraingenieria.com',
      logo: 'https://tomatierraingenieria.com/favicon.svg',
      foundingDate: '2026',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Coruña',
        addressRegion: 'Galicia',
        addressCountry: 'ES',
      },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://tomatierraingenieria.com/#service',
      name: 'Tomatierra Ingeniería',
      alternateName: 'Tomatierra',
      description:
        'Ingeniería especializada en certificados energéticos, auditorías y Certificados de Ahorro Energético (CAE) para viviendas e industria en Galicia. Proyectos de puntos de recarga para vehículos eléctricos y desclasificación de garajes.',
      url: 'https://tomatierraingenieria.com',
      email: 'hola@tomatierraingenieria.com',
      areaServed: [{ '@type': 'State', name: 'Galicia', addressCountry: 'ES' }],
      knowsAbout: [
        'Certificados Energéticos',
        'CAE - Certificados de Ahorro Energético',
        'Auditoría Energética de Viviendas',
        'Diagnóstico Energético Industrial',
        'Eficiencia Energética',
        'Vehículos Eléctricos',
        'Instalaciones Eléctricas para Recarga de Vehículos Eléctricos',
        'Desclasificación de Garajes para Vehículos Eléctricos',
        'Certificación Energética Galicia',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de Certificación Energética y Eficiencia',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Viviendas: certificado energético',
              description:
                'Certificado energético para vender o alquilar: visita y toma de datos, certificado y etiqueta registrados y mejoras ordenadas por ahorro.',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Industria y CAE',
              description:
                'Auditorías energéticas de instalaciones y procesos, medidas de ahorro justificadas y tramitación de Certificados de Ahorro Energético (CAE).',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Movilidad eléctrica',
              description:
                'Proyectos de recarga de vehículo eléctrico en garajes comunitarios, desclasificación de garajes y documentación para comunidad y concello.',
            },
          },
        ],
      },
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Inline y en el <head>: marca que hay JS antes de pintar, para que .reveal no parpadee */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <meta name="language" content="es" />
    <meta name="geo.region" content="ES-GA" />
    <meta name="geo.placename" content="Galicia, España" />
    <meta name="author" content="Tomatierra Ingeniería" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Tomatierra Ingeniería" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1f4a33" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  {/* ontouchstart vacío: activa :active en iOS Safari */}
  <body class="pb-20 antialiased lg:pb-0" ontouchstart="">
    <IconSprite />
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
