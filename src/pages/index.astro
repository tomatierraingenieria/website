---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Steps from '../components/Steps.astro';
import Why from '../components/Why.astro';
import Cae from '../components/Cae.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import StickyCta from '../components/StickyCta.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  ogTitle="Tomatierra Ingeniería · Cuando la energía toca tierra, todo fluye"
  ogDescription="Certificación energética, auditorías, CAE y recarga de vehículo eléctrico en Galicia. Un técnico de principio a fin y sin humo."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Services />
    <Steps />
    <Why />
    <Cae />
    <Faq />
    <QuoteForm />
  </main>
  <StickyCta />
  <Footer />
</BaseLayout>
