---
// Sprite único: logo (brote + tallo + 3 barras) e iconos de trazo (24 × 24).
// Se pinta una vez en BaseLayout; <Icon name="…" /> y el logo mini del pie lo usan con <use href="#…">.
---
<svg class="hidden" aria-hidden="true">
  <symbol id="logo" viewBox="0 0 120 120">
    <g fill="none" stroke-width="5" stroke-linecap="round">
      <path style="stroke: var(--color-moss)" d="M60 30 C 52 24, 46 26, 44 18" />
      <path style="stroke: var(--color-moss)" d="M60 30 C 68 24, 74 26, 76 18" />
      <line style="stroke: var(--color-forest)" x1="60" y1="30" x2="60" y2="62" />
      <line style="stroke: var(--color-copper)" x1="34" y1="72" x2="86" y2="72" />
      <line style="stroke: var(--color-copper)" x1="42" y1="84" x2="78" y2="84" />
      <line style="stroke: var(--color-copper)" x1="50" y1="96" x2="70" y2="96" />
    </g>
  </symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /><path d="M9 12l2 2 4-4" /></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></symbol>
