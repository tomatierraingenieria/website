---
// Icono del sprite (IconSprite.astro). Siempre decorativo: el texto de al lado da el significado.
import type { IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} aria-hidden="true" focusable="false"><use href={`#i-${name}`} /></svg>
