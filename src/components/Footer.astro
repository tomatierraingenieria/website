---
// Pie mínimo, como el original: logo mini + copyright.
// El año se pinta en build (correcto sin JS) y src/scripts/year.ts lo actualiza vía data-year.
const year = new Date().getFullYear();
---
<footer class="border-t border-ink/10 py-6">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p class="flex items-center gap-2 font-display text-lg font-semibold text-forest">
      <svg class="size-7 shrink-0" aria-hidden="true" focusable="false"><use href="#logo" /></svg>
      tomatierra
    </p>
    <p class="font-mono text-xs text-ink-soft">© <span data-year>{year}</span> Tomatierra Ingeniería — Galicia, España</p>
  </div>
</footer>
