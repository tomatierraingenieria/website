---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import EnergyLabel from './EnergyLabel.astro';
import { heroPhoto } from '../data/images';

// TODO: confirmar con el cliente si el registro en la Xunta va incluido en el precio.
const guarantees: { icon: IconName; text: string }[] = [
  { icon: 'shield', text: 'Técnico competente habilitado' },
  { icon: 'pin', text: 'Trabajamos en toda Galicia' },
  { icon: 'file-check', text: 'Gestionamos el registro en la Xunta' },
  { icon: 'mail', text: 'Presupuesto por escrito, sin compromiso' },
];
---
<section id="inicio" class="container-page pt-28 pb-16 lg:pt-36 lg:pb-24" aria-labelledby="hero-title">
  {/* Por debajo de lg la columna de texto se «disuelve» (contents) y las garantías
      pasan detrás de la foto: texto + CTA → foto con etiqueta → garantías.
      No envolver estos hijos en otro elemento. */}
  <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
    <div class="max-lg:contents">
      <div>
        <p class="eyebrow">Certificación energética · Eficiencia · Galicia</p>
        <h1
          id="hero-title"
          class="mt-5 font-display text-5xl leading-[1.02] font-semibold text-balance text-forest sm:text-6xl lg:text-7xl"
        >
          Cuando la energía toca tierra, <em class="font-normal text-leaf">todo fluye</em>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          Certificamos tu vivienda, nave o garaje, lo registramos por ti y te decimos qué mejorar para gastar menos.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#presupuesto" class="btn-primary">Pedir presupuesto</a>
          <a href="#servicios" class="btn-ghost">Ver servicios</a>
        </div>
      </div>

      <ul class="icon-list border-t border-ink/15 pt-6 max-lg:order-last sm:grid-cols-2 lg:mt-10" aria-label="Lo que te garantizamos">
        {guarantees.map((item) => <li><Icon name={item.icon} />{item.text}</li>)}
      </ul>
    </div>

    <figure class="group relative pb-20 lg:pb-0">
      {/* Fondo verde decorativo desplazado tras la foto (solo escritorio) */}
      <div class="absolute inset-y-10 -right-4 left-12 -z-10 hidden rounded-photo bg-mint lg:block" aria-hidden="true"></div>
      <div class="photo-frame rounded-photo">
        <img
          class="aspect-3/2 w-full object-cover photo-zoom sm:aspect-16/9 lg:aspect-4/5"
          src={heroPhoto.src}
          width={heroPhoto.width}
          height={heroPhoto.height}
          alt={heroPhoto.alt}
          fetchpriority="high"
        />
      </div>
      <EnergyLabel />
    </figure>
  </div>
</section>
