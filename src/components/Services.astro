---
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';
import { housingPhoto, industryPhoto, evPhoto, type Photo } from '../data/images';

interface Service {
  title: string;
  lead: string;
  icon: IconName;
  photo: Photo;
  bullets: string[];
}

const services: Service[] = [
  {
    title: 'Viviendas',
    lead: 'El certificado para vender o alquilar, sin vueltas.',
    icon: 'home',
    photo: housingPhoto,
    bullets: ['Visita y toma de datos', 'Certificado y etiqueta registrados', 'Mejoras ordenadas por ahorro'],
  },
  {
    title: 'Industria y CAE',
    lead: 'Dónde se va tu energía y cómo convertir el ahorro en ingreso.',
    icon: 'factory',
    photo: industryPhoto,
    bullets: ['Auditorías de instalaciones y procesos', 'Medidas de ahorro justificadas', 'Tramitación de CAE'],
  },
  {
    title: 'Movilidad eléctrica',
    lead: 'Tu garaje cargando coches, con los papeles en regla.',
    icon: 'plug',
    photo: evPhoto,
    bullets: [
      'Proyecto de recarga en garajes comunitarios',
      'Desclasificación de garajes',
      'Documentación para comunidad y concello',
    ],
  },
];
---
<section id="servicios" class="bg-mint py-20 lg:py-28" aria-labelledby="servicios-title">
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Servicios</p>
      {/* «con chispa» va pegado al svg (sin espacios) para que el subrayado no se separe */}
      <h2 id="servicios-title" class="section-title mt-3">
        Certificación energética, <em class="spark-word">con chispa<svg class="spark-underline" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M3 8 C 50 2, 130 2, 197 7" /></svg></em>
      </h2>
      <p class="section-lead">Elige lo tuyo. Si dudas, te decimos por dónde empezar.</p>
    </div>

    {/* Subgrid en lg: cada .service-card debe ser hijo directo de .service-grid (sin envoltorios) */}
    <ul class="service-grid mt-12">
      {services.map((service) => (
        <li class="service-card group reveal">
          <div class="photo-frame">
            <img
              class="service-img"
              src={service.photo.src}
              width={service.photo.width}
              height={service.photo.height}
              loading="lazy"
              alt={service.photo.alt}
            />
          </div>
          <div class="service-body">
            <span class="icon-badge" aria-hidden="true"><Icon name={service.icon} /></span>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-lead">{service.lead}</p>
            <ul class="check-list mt-4">
              {service.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
