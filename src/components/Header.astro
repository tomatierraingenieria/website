<header>
  <div class="brand">
    <svg
      style="width:44px;height:44px"
      viewBox="0 0 120 120"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path class="sprout" d="M60 30 C 52 24, 46 26, 44 18" />
      <path class="sprout" d="M60 30 C 68 24, 74 26, 76 18" />
      <line class="stem" x1="60" y1="30" x2="60" y2="62" />
      <line class="bar bar1" x1="34" y1="72" x2="86" y2="72" />
      <line class="bar bar2" x1="42" y1="84" x2="78" y2="84" />
      <line class="bar bar3" x1="50" y1="96" x2="70" y2="96" />
    </svg>
    <div class="brand-text">
      <span class="brand-name">tomatierra</span>
