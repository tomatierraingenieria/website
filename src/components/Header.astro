<style>
  svg path, svg line {
    fill: none;
    stroke-width: 4.5;
    stroke-linecap: round;
  }
  .sprout { stroke: var(--moss); }
  .stem   { stroke: var(--soil); }
  .bar    { stroke: var(--copper-bright); }
</style>
